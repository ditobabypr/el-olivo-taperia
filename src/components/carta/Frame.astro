---
/** Marco ornamental (doble filete + florones en las esquinas y adornos centrales) para las fotos de la carta. */
---
<div class="cm-frame">
  <slot />
  <span class="cm-frame__corner cm-frame__corner--tl" aria-hidden="true"></span>
  <span class="cm-frame__corner cm-frame__corner--tr" aria-hidden="true"></span>
  <span class="cm-frame__corner cm-frame__corner--bl" aria-hidden="true"></span>
  <span class="cm-frame__corner cm-frame__corner--br" aria-hidden="true"></span>
  <span class="cm-frame__mid cm-frame__mid--t" aria-hidden="true"></span>
  <span class="cm-frame__mid cm-frame__mid--b" aria-hidden="true"></span>
</div>

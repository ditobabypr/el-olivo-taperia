---
import BrandMark from './BrandMark.astro';
import { introCssVars } from '../config/intro';
---
<div class="splash" id="intro" style={introCssVars} aria-hidden="true">
  <BrandMark />
</div>

<style is:global>
  /* Oculta por defecto: sin JS o sin 'intro-on' la web se ve normal */
  .splash { display: none; }
  html.intro-on { overflow: hidden; }
  html.intro-on .splash {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 1000; overflow: hidden;
    background: var(--cream); overscroll-behavior: contain;
    animation: intro-out var(--t-out) ease var(--t-hold) forwards;
  }
  @keyframes intro-out { to { opacity: 0; visibility: hidden; } }
</style>
